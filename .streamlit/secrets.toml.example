# 이 파일을 secrets.toml로 복사하고 실제 키를 입력하세요.
# Streamlit Community Cloud에서는 앱 설정의 Secrets에 입력하세요.
BAZE_API_KEY = "여기에_실제_API_키"
BAZE_MODEL = "gpt-6-luna"

# 클라우드에서 영구 기록을 보관할 PostgreSQL 서버 연결 문자열.
# Supabase를 사용하면 Connect > Transaction/Session pooler의 연결 문자열을 사용하세요.
# sql/schema.sql을 DB에서 먼저 실행하세요. 서버 전용이며 공개하면 안 됩니다.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Google Cloud Console에서 OAuth 클라이언트(웹 애플리케이션)를 생성하고
# 승인된 리디렉션 URI에 아래 주소를 동일하게 등록하세요.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "충분히_긴_무작위_문자열"
# client_id = "구글_OAuth_클라이언트_ID"
# client_secret = "구글_OAuth_클라이언트_시크릿"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
